# Copy to .env and adjust for your environment. Every value can also be
# provided as a plain environment variable with the same CS_ prefix.

# --- Core ---
CS_ENVIRONMENT=production
CS_DEBUG=false
CS_HOST=0.0.0.0
CS_PORT=8000
CS_SECRET_KEY=change-me-to-a-random-64-character-string
CS_LOG_LEVEL=INFO

# Public origins allowed to make state-changing requests (comma separated).
# Same-origin requests are always allowed.
CS_ALLOWED_ORIGINS=https://codeshield.example.com

# --- Database ---
CS_DATABASE_URL=sqlite:///./data/codeshield.db

# --- Bootstrap administrator ---
CS_ADMIN_EMAIL=admin@codeshield.dev
CS_ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Sessions and tokens ---
CS_ACCESS_TOKEN_MINUTES=15
CS_REFRESH_TOKEN_DAYS=7
CS_COOKIE_SECURE=true
CS_COOKIE_SAMESITE=lax

# --- Abuse protection ---
CS_RATE_LIMIT_PER_MINUTE=240
CS_AUTH_RATE_LIMIT_PER_MINUTE=12
CS_LOGIN_MAX_FAILURES=5
CS_LOGIN_LOCKOUT_MINUTES=15

# --- Scanning ---
CS_MAX_CODE_BYTES=200000
CS_SCAN_TIMEOUT_SECONDS=12

# --- Anomaly detection ---
CS_MODEL_DIR=./data/models
CS_ANOMALY_CONTAMINATION=0.03
